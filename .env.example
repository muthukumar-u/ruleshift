# Copy to .env and fill only the values you need. Never commit real keys.
# CLI does not auto-load .env; load it in your terminal with:
# set -a
# source .env
# set +a
# Local, self-hosted Grafana and PostgreSQL. No observability-service API key.
GRAFANA_PORT=3018
GRAFANA_PASSWORD=ruleshift-local-dev
POSTGRES_PASSWORD=ruleshift-local-dev
READER_PASSWORD=ruleshift-reader-local
# Set only the model-provider keys you actually use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
RULESHIFT_API_KEY=
RULESHIFT_DB=data/ruleshift.sqlite
RULESHIFT_REPORTS=reports
